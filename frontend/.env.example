# Base URL of the Flask API (no trailing slash).
# Local:  http://localhost:5000/api/v1
# Render: set automatically from the API service host by render.yaml (VITE_API_HOST),
#         or set VITE_API_BASE_URL=https://<your-api>.onrender.com/api/v1 explicitly.
VITE_API_BASE_URL=http://localhost:5000/api/v1
