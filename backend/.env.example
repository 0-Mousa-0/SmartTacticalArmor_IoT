# Copy to .env (never commit .env). Every value can also be set in Render.

# ── Flask ────────────────────────────────────────────────────
FLASK_ENV=development
# Signs operator session tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173
JWT_EXPIRES_MINUTES=480
LOG_LEVEL=INFO

# ── Supabase Postgres (SQLAlchemy) ───────────────────────────
# Supabase dashboard -> Connect -> "Session pooler" (port 5432, IPv4).
# Leave empty to use a local SQLite file (sta_dev.db) for development.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>.pooler.supabase.com:5432/postgres

# ── First admin (optional; created on startup only if no admin exists) ──
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=System Administrator

# ── MQTT broker (EMQX Cloud Serverless) ──────────────────────
MQTT_ENABLED=false
MQTT_HOST=<deployment>.ala.<region>.emqxsl.com
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=sta-backend
MQTT_PASSWORD=<password created in EMQX Access Control>
MQTT_CLIENT_ID=sta-backend
MQTT_CLEAN_SESSION=false
MQTT_TOPIC_ROOT=sta/v1

# ── Devices & data retention ─────────────────────────────────
DEVICE_AUTO_REGISTER=false
TELEMETRY_STORE_MIN_INTERVAL_S=5
TELEMETRY_RETENTION_DAYS=7
CONTACT_LOST_AFTER_S=60
COMMAND_TIMEOUT_S=30

# ── AI analysis ──────────────────────────────────────────────
ANALYSIS_Z_THRESHOLD=3.0
ANALYSIS_WARMUP_SAMPLES=30
ANALYSIS_EWMA_ALPHA=0.05
ANALYSIS_PERSIST_READINGS=3
