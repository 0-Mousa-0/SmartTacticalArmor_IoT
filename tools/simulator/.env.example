# Copy to .env (never commit it). Values come from the EMQX console (docs/07-setup-emqx.md).
SIM_MQTT_HOST=<deployment>.ala.<region>.emqxsl.com
SIM_MQTT_PORT=8883
SIM_MQTT_TLS=true
SIM_MQTT_USERNAME=sta-simulator
SIM_MQTT_PASSWORD=<password>
SIM_TOPIC_ROOT=sta/v1
SIM_DEVICES=STA-02,STA-03,STA-04,STA-05,STA-06
SIM_INTERVAL_S=5
